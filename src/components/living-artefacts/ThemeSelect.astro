---
const fr=!Astro.url.pathname.startsWith('/en');
---
<label class="xai-theme-select"><span class="xo-sr-only">{fr?'Apparence':'Appearance'}</span><select data-theme-select aria-label={fr?'Apparence':'Appearance'}><option value="system">{fr?'Système':'System'}</option><option value="light">{fr?'Clair':'Light'}</option><option value="dark">{fr?'Sombre':'Dark'}</option></select></label>
