---
// Onglets de modes/surfaces — panel = carte pricing x.ai · console = terminal #151515 (dossier mono).
interface ModeTab {
  id: string;
  label: string;
  content: string;
}

interface Props {
  tabs: ModeTab[];
  artifactTitle?: string;
  uid?: string;
  variant?: "panel" | "console";
  class?: string;
  lang?: "en" | "fr";
}

const {
  tabs,
  artifactTitle,
  uid: uidProp,
  variant = "panel",
  class: className = "",
  lang: langProp,
} = Astro.props;

const lang = langProp ?? (Astro.url.pathname.startsWith("/en") ? "en" : "fr");
const tablistLabel = artifactTitle
  ? `${artifactTitle} — ${lang === "en" ? "tabs" : "onglets"}`
  : lang === "en"
    ? "Tabs"
    : "Onglets";

// Préfixe unique par instance pour lier onglet ↔ panneau (aria-controls / aria-labelledby).
const uid = (uidProp ?? artifactTitle ?? tabs.map((t) => t.id).join("-"))
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-|-$/g, "");

const isConsole = variant === "console";
---

<div
  class:list={[
    "mode-tabs",
    isConsole
      ? "xo-mode-tabs--console"
      : ["xo-artifact-panel", "xo-mode-tabs--panel"],
    className,
  ]}
  data-mode-tabs
  data-mode-variant={variant}
>
  <div class="mode-tabs-header">
    {artifactTitle && <span class="mode-tabs-title">{artifactTitle}</span>}
    <div class="mode-tabs-bar" role="tablist" aria-label={tablistLabel}>
      {tabs.map((tab, index) => (
        <button
          class="mode-tab-pill"
          type="button"
          role="tab"
          id={`tab-${uid}-${tab.id}`}
          aria-controls={`panel-${uid}-${tab.id}`}
          data-mode-tab={tab.id}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? "0" : "-1"}
        >
          {tab.label}
        </button>
      ))}
    </div>
  </div>
  <div class="mode-tabs-content">
    {tabs.map((tab, index) => (
      <div
        class="mode-tab-panel"
        id={`panel-${uid}-${tab.id}`}
        aria-labelledby={`tab-${uid}-${tab.id}`}
        data-mode-panel={tab.id}
        aria-hidden={index !== 0 ? "true" : "false"}
        inert={index !== 0}
        tabindex={index === 0 ? 0 : -1}
        role="tabpanel"
        set:html={tab.content}
      />
    ))}
    {isConsole && <div class="xo-progressive-blur" aria-hidden="true"></div>}
  </div>
</div>

<script>
  function getModeTabGroups(root: ParentNode): HTMLElement[] {
    if (root instanceof HTMLElement && root.matches("[data-mode-tabs]")) {
      return [root];
    }
    return Array.from(root.querySelectorAll<HTMLElement>("[data-mode-tabs]"));
  }

  function initModeTabs(root: ParentNode = document) {
    getModeTabGroups(root).forEach((group) => {
      if (group.dataset.modeTabsInit === "1") return;
      group.dataset.modeTabsInit = "1";

      const pills =
        group.querySelectorAll<HTMLButtonElement>("[data-mode-tab]");
      const panels = group.querySelectorAll<HTMLElement>("[data-mode-panel]");

      const activate = (id: string) => {
        pills.forEach((pill) => {
          const active = pill.dataset.modeTab === id;
          pill.setAttribute("aria-selected", active ? "true" : "false");
          pill.tabIndex = active ? 0 : -1;
        });
        panels.forEach((panel) => {
          const active = panel.dataset.modePanel === id;
          panel.setAttribute("aria-hidden", String(!active));
          panel.inert = !active;
          panel.tabIndex = active ? 0 : -1;
        });
      };

      pills.forEach((pill) =>
        pill.addEventListener("click", () => {
          if (pill.dataset.modeTab) activate(pill.dataset.modeTab);
        }),
      );

      const bar = group.querySelector<HTMLElement>('[role="tablist"]');
      if (bar) {
        bar.addEventListener("keydown", (event) => {
          const target = event.target as HTMLButtonElement;
          if (!target.matches("[data-mode-tab]")) return;
          const list = Array.from(pills);
          const idx = list.indexOf(target);
          let next: number | null = null;
          if (event.key === "ArrowRight") next = (idx + 1) % list.length;
          if (event.key === "ArrowLeft")
            next = (idx - 1 + list.length) % list.length;
          if (event.key === "Home") next = 0;
          if (event.key === "End") next = list.length - 1;
          if (next !== null) {
            event.preventDefault();
            const n = list[next];
            n.focus();
            const id = n.dataset.modeTab;
            if (id) activate(id);
          }
        });
      }
    });
  }

  function boot() {
    initModeTabs(document);
  }

  boot();
  document.addEventListener("astro:after-swap", boot);
</script>

<style>
  .mode-tabs {
    border: 1px solid var(--use-line);
    border-radius: 16px;
    background: var(--use-surface);
    color: var(--use-ink);
    overflow: hidden;
  }
  .mode-tabs-header {
    padding: 16px;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--use-line);
  }
  .mode-tabs-title {
    font: 12px/18px var(--eco-font-mono);
    color: var(--use-muted);
  }
  .mode-tabs-bar {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }
  .mode-tab-pill {
    font: 14px/20px var(--eco-font-sans);
    color: var(--use-muted);
    background: transparent;
    border: 0;
    border-radius: 8px;
    padding: 12px;
    min-height: 44px;
    cursor: pointer;
  }
  .mode-tab-pill[aria-selected="true"] {
    background: var(--use-bg);
    color: var(--use-ink);
  }
  .mode-tabs-content {
    display: grid;
    padding: 24px;
  }
  .mode-tab-panel {
    grid-area: 1/1;
    min-width: 0;
    font: 16px/1.6 var(--eco-font-mono);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .mode-tab-panel[aria-hidden="true"] {
    visibility: hidden;
    pointer-events: none;
  }
  @media (max-width: 639px) {
    .mode-tabs-content {
      padding: 20px;
    }
  }
</style>
