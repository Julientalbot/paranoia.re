---
interface Props {
  text: string;
  id?: string;
  class?: string;
  rotate?: string[];
  underline?: string;
}
const { text, id, class: className = "", rotate, underline } = Astro.props;
const words = rotate?.length ? rotate : underline ? [underline] : [];
const heading = [text, words[0]].filter(Boolean).join(" ");
---

<div class="headline-group" data-headline>
  <h1 id={id} class:list={["xo-title", className]} aria-label={heading}>
    {text}
    {words.length > 0 && (
      <span
        class="headline-words"
        data-hero-rotate
        data-words={JSON.stringify(words)}
        aria-hidden="true"
      >
        {words.map((word, index) => (
          <span class:list={["headline-word", index === 0 && "is-current"]}>
            {word}
          </span>
        ))}
      </span>
    )}
  </h1>
</div>
<script>
  import { createPlayback } from "../../lib/playback.mjs";
  document.querySelectorAll<HTMLElement>("[data-headline]").forEach((root) => {
    if (root.dataset.bound) return;
    root.dataset.bound = "true";
    const words = [...root.querySelectorAll<HTMLElement>(".headline-word")];
    if (words.length < 2) return;
    createPlayback(root, {
      frames: words.length,
      interval: 3000,
      loop: true,
      render(frame, reduced) {
        words.forEach((word, index) =>
          word.classList.toggle("is-current", index === (reduced ? 0 : frame)),
        );
      },
    });
  });
</script>
<style>
  .headline-group {
    position: relative;
  }
  .headline-words {
    display: grid;
    min-height: 1.1em;
  }
  .headline-word {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 250ms,
      transform 250ms;
    text-decoration: underline;
    text-decoration-color: var(--xai-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }
  .headline-word.is-current {
    visibility: visible;
    opacity: 1;
    transform: none;
  }
</style>
