---
interface Props { text: string; id?: string; class?: string; rotate?: string[]; underline?: string; }
const { text, id, class: className = '', rotate, underline } = Astro.props;
// Stable text for all visitors, including crawlers and assistive technology.
const heading = [text, rotate?.[0] || underline].filter(Boolean).join(' ');
---
<h1 id={id} class:list={['xo-title', className]}>{heading}</h1>
