---
interface Props {
  lang?: "fr" | "en";
}
const { lang = "fr" } = Astro.props;
const fr = lang === "fr";
const tabs = fr
  ? ["Détecter", "Masquer", "Relire"]
  : ["Detect", "Mask", "Review"];
---

<div class="xai-prompt-demo" data-prompt-demo>
  <div class="xai-demo-top">
    <span class="xai-demo-dots" aria-hidden="true">
      ● ● ●
    </span>
    <span>Paranoia</span>
    <span class="xai-demo-state">
      {fr ? "Exemple fictif" : "Fictional example"}
    </span>
  </div>
  <div
    role="tablist"
    aria-label={fr ? "Étapes du masquage" : "Masking steps"}
    class="xai-prompt-tabs"
  >
    {tabs.map((tab, i) => (
      <button
        type="button"
        role="tab"
        id={`prompt-tab-${i}`}
        aria-controls={`prompt-panel-${i}`}
        aria-selected={i === 0 ? "true" : "false"}
        tabindex={i === 0 ? 0 : -1}
        data-prompt-tab={i}
      >
        {tab}
      </button>
    ))}
  </div>
  <div class="xai-prompt-panels">
    <div
      role="tabpanel"
      id="prompt-panel-0"
      aria-labelledby="prompt-tab-0"
      tabindex="0"
    >
      <p>{fr ? "Texte à inspecter" : "Text to inspect"}</p>
      <div class="xai-prompt-text">
        {fr ? "Résume cet échange avec" : "Summarize this exchange with"}{" "}
        <mark>Maya Hoarau</mark> (<mark>maya@exemple.invalid</mark>){" "}
        {fr ? "au sujet du dossier" : "about file"} <mark>K-47B</mark>.
      </div>
      <div class="xai-detections">
        <span>{fr ? "Personne" : "Person"}</span>
        <span>Email</span>
        <span>{fr ? "Identifiant" : "Identifier"}</span>
      </div>
    </div>
    <div
      role="tabpanel"
      id="prompt-panel-1"
      aria-labelledby="prompt-tab-1"
      tabindex="-1"
      aria-hidden="true"
      inert
    >
      <p>{fr ? "Version masquée" : "Masked version"}</p>
      <div class="xai-prompt-text">
        {fr ? "Résume cet échange avec" : "Summarize this exchange with"}{" "}
        <mark>[{fr ? "Personne" : "Person"}]</mark> (<mark>[Email]</mark>){" "}
        {fr ? "au sujet du dossier" : "about file"}{" "}
        <mark>[{fr ? "Identifiant" : "Identifier"}]</mark>.
      </div>
      <div class="xai-detections">
        <span>{fr ? "Substitutions visibles" : "Visible substitutions"}</span>
      </div>
    </div>
    <div
      role="tabpanel"
      id="prompt-panel-2"
      aria-labelledby="prompt-tab-2"
      tabindex="-1"
      aria-hidden="true"
      inert
    >
      <p>{fr ? "Votre contrôle avant l’envoi" : "Your check before sending"}</p>
      <div class="xai-prompt-text">
        {fr
          ? "Résume cet échange avec [Personne] ([Email]) au sujet du dossier [Identifiant]."
          : "Summarize this exchange with [Person] ([Email]) about file [Identifier]."}
      </div>
      <ul class="xai-checks">
        <li>{fr ? "Relire les substitutions" : "Review the substitutions"}</li>
        <li>
          {fr
            ? "Chercher les informations restées identifiantes"
            : "Look for information that still identifies someone"}
        </li>
        <li>
          {fr
            ? "Décider si le texte peut être transmis"
            : "Decide whether the text can be shared"}
        </li>
      </ul>
    </div>
  </div>
  <div class="xai-demo-controls">
    <span>
      {fr
        ? "Démonstration locale. Aucun texte envoyé."
        : "Local demonstration. No text is sent."}
    </span>
  </div>
</div>
<script>
  document
    .querySelectorAll<HTMLElement>("[data-prompt-demo]")
    .forEach((demo) => {
      const tabs = [
        ...demo.querySelectorAll<HTMLButtonElement>("[data-prompt-tab]"),
      ];
      const panels = [...demo.querySelectorAll<HTMLElement>("[role=tabpanel]")];
      const select = (i: number, focus = false) => {
        tabs.forEach((tab, j) => {
          tab.setAttribute("aria-selected", String(i === j));
          tab.tabIndex = i === j ? 0 : -1;
          panels[j].setAttribute("aria-hidden", String(i !== j));
          panels[j].inert = i !== j;
          panels[j].tabIndex = i === j ? 0 : -1;
        });
        if (focus) tabs[i].focus();
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => select(i));
        tab.addEventListener("keydown", (event) => {
          const next =
            event.key === "ArrowRight"
              ? (i + 1) % tabs.length
              : event.key === "ArrowLeft"
                ? (i + tabs.length - 1) % tabs.length
                : event.key === "Home"
                  ? 0
                  : event.key === "End"
                    ? tabs.length - 1
                    : null;
          if (next !== null) {
            event.preventDefault();
            select(next, true);
          }
        });
      });
    });
</script>

<style>
  .xai-prompt-panels {
    display: grid;
    align-items: start;
  }
  .xai-prompt-panels [role="tabpanel"] {
    grid-area: 1/1;
    min-width: 0;
  }
  .xai-prompt-panels [aria-hidden="true"] {
    visibility: hidden;
    pointer-events: none;
  }
</style>
