---
import BaseLayout from '../layouts/BaseLayout.astro';
import PromptExample from './PromptExample.astro';
import FormContact from './FormContact.astro';
interface Props { lang: 'fr' | 'en'; }
const {lang}=Astro.props;
const fr=lang==='fr';
const contact=fr?'/pilote#contact':'#contact';
---
<BaseLayout lang={lang} title={fr?'Paranoia — relire les données avant l’envoi à une IA':'Paranoia — review sensitive data before sending to AI'} description={fr?'Paranoia : pilote accompagné pour détecter et masquer des données sensibles avant l’envoi à une IA. Exemple, fonctionnement et limites du produit.':'Paranoia: a guided pilot to detect and mask sensitive data before sending to AI. See an example, how the product works and its limitations.'}>
<main id="main" class="useful">
  <section class="use-hero"><p class="use-label">{fr?'Confidentialité des prompts — pilote accompagné':'Prompt privacy — guided pilot'}</p><h1>{fr?'Voir ce qui risque de partir. Relire avant d’envoyer.':'See what could leave. Review before sending.'}</h1><p class="use-lede">{fr?'Paranoia aide à repérer et masquer les données sensibles dans le texte destiné à une IA. Vous vérifiez la version obtenue avant de l’utiliser.':'Paranoia helps identify and mask sensitive data in text intended for AI. You review the result before using it.'}</p><div class="use-actions"><a class="xo-button xo-button--primary" href={contact}>{fr?'Discuter d’un pilote':'Discuss a pilot'}</a><a class="xo-button" href="#concrete">{fr?'Voir un exemple':'See an example'}</a></div></section>
  <section id="concrete"><h2>{fr?'Un texte, deux versions, votre décision.':'One text, two versions, your decision.'}</h2><PromptExample lang={lang} /></section>
  <section class="use-split"><div><h2>{fr?'Où se situe Paranoia ?':'Where does Paranoia fit?'}</h2><p>{fr?'L’implémentation actuelle est une extension Chrome qui analyse le texte localement, dans des champs de saisie. Elle associe des règles de détection à un modèle local.':'The current implementation is a Chrome extension that analyzes text locally in input fields. It combines detection rules with a local model.'}</p><p>{fr?'Le pilote n’est pas une installation en libre-service. La version proposée, les pages compatibles et les conditions d’installation sont vérifiées ensemble avant activation.':'The pilot is not a self-service installation. The offered version, supported pages and installation conditions are checked together before activation.'}</p></div><div><h3>{fr?'Le parcours':'The workflow'}</h3><ol><li>{fr?'Choisir un usage et un exemple fictif.':'Choose a use case and a fictional example.'}</li><li>{fr?'Inspecter les détections et appliquer le masquage.':'Inspect detections and apply masking.'}</li><li>{fr?'Relire tout le texte, y compris ce qui n’a pas été masqué.':'Review the entire text, including what was not masked.'}</li><li>{fr?'Décider si l’envoi est approprié.':'Decide whether sending is appropriate.'}</li></ol></div></section>
  <section class="use-split"><div><h2>{fr?'Un contrôle utile, avec des limites.' : 'A useful check, with limits.'}</h2><p>{fr?'Une détection peut manquer une donnée ou masquer un texte utile. Certains éditeurs et mécanismes d’envoi nécessitent des adaptations. Le modèle local demande aussi des ressources sur votre machine.':'Detection can miss data or mask useful text. Some editors and sending mechanisms need adaptations. The local model also requires resources on your device.'}</p></div><div><p>{fr?'Paranoia ne remplace ni une politique de confidentialité, ni une autorisation de transmettre les données, ni la relecture humaine. Aucune certification ou conformité automatique n’est revendiquée.':'Paranoia does not replace a privacy policy, permission to disclose data or human review. No certification or automatic compliance is claimed.'}</p><a href="/securite">{fr?'Lire les limites et les contrôles':'Read limitations and controls (FR)'}</a></div></section>
  <section id="contact" class="use-split"><div><h2>{fr?'Tester sur un usage précis.' : 'Test a specific use case.'}</h2><p>{fr?'Le premier échange sert à vérifier si le produit répond à votre besoin. Le périmètre, les modalités et les éventuels coûts sont convenus avant activation.':'The first conversation checks whether the product fits your needs. Scope, arrangements and any costs are agreed before activation.'}</p><p>{fr?'Ne transmettez pas de documents confidentiels pour ce premier contact.':'Do not send confidential documents with your first message.'}</p>{fr&&<a class="xo-button xo-button--primary" href="/pilote#contact">Demander un accès pilote</a>}</div>{fr?<div><h3>Le traitement des données</h3><p>Le formulaire du site et l’extension sont deux contextes distincts. Les informations transmises volontairement par email ne sont pas couvertes par le masquage de l’extension.</p><a href="/confidentialite">Lire la confidentialité</a><p><a href="/en" lang="en">Read this page in English</a></p></div>:<FormContact lang="en" />}</section>
</main>
</BaseLayout>
