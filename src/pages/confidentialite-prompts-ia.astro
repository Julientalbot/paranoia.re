import Layout from '../layouts/InformationLayout.astro';
import PromptExample from '../components/PromptExample.astro';
---
<Layout title="Masquer ne suffit pas toujours." description="Un texte masqué doit rester utile sans exposer ce qui ne doit pas sortir. Examinez le résultat et le contexte avant tout usage dans une IA.">
<section><h2>La version obtenue doit être relue.</h2><PromptExample /></section>
<section class="use-split"><div><h2>Trois questions avant l’envoi</h2><ol><li>Le contenu peut-il être communiqué à cet outil ?</li><li>Le texte restant permet-il encore d’identifier une personne ou une situation ?</li><li>Le masquage a-t-il changé le sens ou supprimé un élément nécessaire ?</li></ol></div><div><p>La détection technique ne répond pas seule à ces questions. Les règles de votre organisation, vos engagements envers les personnes et votre jugement restent déterminants.</p><p><a href="/confidentialite">Données du site et du pilote</a></p><p><a href="/pilote#contact">Discuter d’un usage</a></p></div></section>
</Layout>
